# Copy to .env and adjust. Never commit .env — it holds server-side credentials.

# --- Database -----------------------------------------------------------------
# Default: SQLite file at backend/data/cma.db (no setup needed).
# PostgreSQL/PostGIS: postgresql+psycopg://cma:PASSWORD@localhost:5432/cma
# DATABASE_URL=sqlite:///./data/cma.db
# POSTGRES_PASSWORD=change-me            # used by docker-compose.yml

# --- Market and data provider -------------------------------------------------
TARGET_ZIPS=22308,22309
DATA_PROVIDER=fairfax_arcgis
ARCGIS_BASE_URL=https://services1.arcgis.com/ioennV6PpG5Xodq0/ArcGIS/rest/services
# The county layers are public. Only set a token if the county or Esri issues one.
ARCGIS_TOKEN=
REFRESH_CONCURRENCY=4

# --- AI assistant (optional) --------------------------------------------------
# Search, ranking, pricing and reports work without it. Keys stay on the server only.
# AI_PROVIDER: auto (OpenAI if OPENAI_API_KEY is set, else Anthropic) | openai | anthropic | none
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Blank = the model's default. Set only to a value the model accepts (e.g. low, medium, high).
OPENAI_REASONING_EFFORT=
# Optional alternative provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Default report branding (editable in the app) ----------------------------
BRAND_COMPANY=Your Brokerage
BRAND_AGENT_NAME=
BRAND_PHONE=
BRAND_EMAIL=
BRAND_COLOR=#1F4E79

# --- Web ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared login for everyone using the app (HTTP Basic). Strongly recommended on any server.
APP_USERNAME=team
APP_PASSWORD=
